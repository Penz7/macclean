class SysInfo:
    def __init__(self):
        self.parts = [("Đang đọc thông tin hệ thống…", False)]

    def refresh_async(self):
        threading.Thread(target=self.refresh, daemon=True).start()

    def refresh(self):
        parts = []
        du = shutil.disk_usage(DATA_VOL)
        pct = du.used / (du.used + du.free) if du.used + du.free else 0
        parts.append((f"Ổ đĩa: {human(du.free)} trống ({pct:.0%} đã dùng)", pct > 0.9))
        sw = swap_usage()
        if sw:
            used, total = sw
            parts.append((f"Swap: {used / GIB:.1f}/{total / GIB:.1f}G", total > 0 and used / total > 0.8))
        ncpu = os.cpu_count() or 1
        l1 = os.getloadavg()[0]
        parts.append((f"Tải: {l1:.1f}/{ncpu}", l1 > ncpu))
        lim = cpu_speed_limit()
        if lim is not None and lim < 100:
            parts.append((f"CPU: {lim}% tốc độ", True))
        batt = re.search(r"(\d+)%", run(["pmset", "-g", "batt"]).stdout)
        if batt:
            sp = run(["system_profiler", "SPPowerDataType"], timeout=30).stdout
            cyc = re.search(r"Cycle Count:\s*(\d+)", sp)
            cond = re.search(r"Condition:\s*(.+)", sp)
            cond = cond.group(1).strip() if cond else ""
            txt = f"Pin: {batt.group(1)}%" + (f", {cyc.group(1)} chu kỳ" if cyc else "") + (f", {cond}" if cond else "")
            parts.append((txt, bool(cond) and cond != "Normal"))
        sip = run(["csrutil", "status"]).stdout
        if sip:
            on = "enabled" in sip
            parts.append(("SIP: bật" if on else "SIP: TẮT", not on))
        self.parts = parts

    def free(self):
        return shutil.disk_usage(DATA_VOL).free


# ───────────────────────────── TUI ─────────────────────────────

C_SUGG, C_BIG, C_WARN, C_SEL, C_DIM, C_HEAD = range(1, 7)


@dataclass
class View:
    key: str
    name: str
    groups: list
    scan: object
    items: list = field(default_factory=list)
    collapsed: set = field(default_factory=set)
    cur: int = 0
    top: int = 0
    scanning: bool = False
    scanned: bool = False


def _view_attr(name):
    return property(lambda self: getattr(self.v, name), lambda self, val: setattr(self.v, name, val))


class App:
    items = _view_attr("items")
    collapsed = _view_attr("collapsed")
    cur = _view_attr("cur")
    top = _view_attr("top")
    scanning = _view_attr("scanning")

    def __init__(self, scr, dry_run=False, view="disk"):
        self.scr = scr
        self.dry = dry_run
        self.views = {"disk": View("disk", "Dung lượng", GROUPS, scan_all),
                      "startup": View("startup", "Khởi động & hiệu năng", STARTUP_GROUPS, scan_startup)}
        self.v = self.views[view]
        self.msg = ""
        self.msg_warn = False
        self.spin = 0
        self.sys = SysInfo()
        self.pool = ThreadPoolExecutor(max_workers=8)

    @property
    def startup(self):
        return self.v.key == "startup"

    # ── quét ──
    def start_scan(self, keep=False, done_msg=None):
        v = self.v
        if v.scanning:
            return
        v.scanning = v.scanned = True
        v.items = []
        if not keep:
            v.cur = v.top = 0
        self.set_msg("Đang quét…")
        self.sys.refresh_async()
        threading.Thread(target=self._scan, args=(v, done_msg), daemon=True).start()

    def _scan(self, v, done_msg=None):
        msg, warn = "", False
        try:
            items = v.scan()
            v.items = items
            for f in [self.pool.submit(fill_size, it) for it in items if it.size is None]:
                f.result()
            sugg = [i for i in items if i.suggested and visible(i)]
            if done_msg:
                msg, warn = done_msg
            elif v.key == "startup":
                msg = (f"Quét xong. Có {len(sugg)} mục nên tắt (*) — f tắt nhanh, i xem chi tiết, e bật lại."
                       if sugg else "Quét xong. Không có mục nào cần tắt.")
            elif sugg:
                msg = (f"Quét xong. Có {len(sugg)} mục gợi ý (*) · {human(sum(i.size or 0 for i in sugg))}"
                       " — nhấn f để dọn nhanh.")
            else:
                msg = "Quét xong. Không có mục gợi ý nào — máy đang gọn gàng."
        except Exception as e:  # noqa: BLE001
            msg, warn = f"Lỗi khi quét: {e}", True
        finally:
            v.scanning = False
        if v is self.v:
            self.set_msg(msg, warn)

    def set_msg(self, text, warn=False):
        self.msg, self.msg_warn = text, warn

    def switch(self, key):
        if key == self.v.key:
            return
        self.v = self.views[key]
        self.msg = ""
        if not self.v.scanned:
            self.start_scan()

    # ── danh sách hàng hiển thị ──
    def rows(self):
        out = []
        for key, _, _ in self.v.groups:
            its = [i for i in self.items if i.group == key and not i.deleted and visible(i)]
            if not its:
                continue
            out.append(("h", key, its))
            if key in self.collapsed:
                continue
            if key in SORT_BY_SIZE and all(i.size is not None for i in its):
                its = sorted(its, key=lambda i: i.size, reverse=True)
            out.extend(("i", i, None) for i in its)
        return out

    def pending(self):
        return sum(1 for i in self.items if i.size is None)

    # ── vẽ ──
    def put(self, y, x, s, attr=0):
        try:
            self.scr.addstr(y, x, s, attr)
        except curses.error:
            pass

    def draw(self):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        if h < 12 or w < 60:
            self.put(0, 0, fit("Cửa sổ quá nhỏ — hãy phóng to terminal (tối thiểu 60×12).", w - 1))
            scr.refresh()
            return

        # tiêu đề + tab
        busy = self.scanning or self.pending()
        self.spin = (self.spin + 1) % 4
        self.put(0, 0, " macclean ", curses.A_BOLD | curses.color_pair(C_HEAD))
        x = 10
        for n, v in enumerate(self.views.values(), 1):
            tab = f" {n} {v.name} "
            self.put(0, x, tab, curses.A_REVERSE | curses.A_BOLD if v is self.v else curses.color_pair(C_DIM))
            x += len(tab) + 1
        extra = "[DRY-RUN] " if self.dry else ""
        if busy:
            extra += "|/-\\"[self.spin] + (f" đang tính dung lượng ({self.pending()} mục)" if self.pending()
                                         else " đang quét")
        self.put(0, x, fit(extra, max(0, w - x - 1)), curses.A_BOLD | curses.color_pair(C_HEAD))

        # thông tin hệ thống
        x = 1
        for n, (txt, warn) in enumerate(self.sys.parts):
            if n:
                self.put(1, x, " │ ", curses.color_pair(C_DIM))
                x += 3
            seg = fit(txt, max(0, w - x - 1)).rstrip()
            self.put(1, x, seg, curses.color_pair(C_WARN) | curses.A_BOLD if warn else 0)
            x += len(seg)
        self.put(2, 0, "─" * (w - 1), curses.color_pair(C_DIM))

        # danh sách
        rows = self.rows()
        H = h - 6
        self.cur = max(0, min(self.cur, len(rows) - 1))
        if self.cur < self.top:
            self.top = self.cur
        elif self.cur >= self.top + H:
            self.top = self.cur - H + 1
        self.top = max(0, min(self.top, max(0, len(rows) - H)))

        if not rows:
            self.put(4, 2, "Đang quét…" if self.scanning else "Không tìm thấy gì để dọn. 🎉")

        nw = min(20, max(0, w - 64))
        lw = w - 8 - 1 - 8 - 2 - nw - 1
        for idx in range(self.top, min(len(rows), self.top + H)):
            y = 3 + idx - self.top
            kind, obj, its = rows[idx]
            cursor = curses.A_REVERSE if idx == self.cur else 0
            if kind == "h":
                nsel = sum(1 for i in its if i.selected)
                arrow = "▸" if obj in self.collapsed else "▾"
                if obj in STARTUP_KEYS:
                    nsug = sum(1 for i in its if i.suggested)
                    right = f"{len(its)} mục" + (f" · nên tắt {nsug}" if nsug else "")
                else:
                    right = f"{len(its)} mục · {human(sum(i.size or 0 for i in its))}"
                right += f" · đã chọn {nsel}" if nsel else ""
                left = f"{arrow} {GROUP_TITLE[obj]}"
                line = fit(left, w - 2 - len(right) - 1) + right + " "
                self.put(y, 0, line, curses.A_BOLD | curses.color_pair(C_HEAD) | cursor)
            else:
                it = obj
                info = it.kind == "info"
                mark = " • " if info else "[x]" if it.selected else "[ ]"
                star = "*" if it.suggested else " "
                big = it.size is not None and it.size >= GIB
                label_attr = curses.color_pair(C_SEL) | curses.A_BOLD if it.selected else 0
                if info and it.extra.get("warn"):
                    label_attr = curses.color_pair(C_WARN) | curses.A_BOLD
                elif it.extra.get("state") == "off":
                    label_attr = curses.color_pair(C_DIM)
                if it.error:
                    label_attr = curses.color_pair(C_WARN)
                size = "" if it.group in STARTUP_KEYS and not it.size else human(it.size)
                self.put(y, 0, "  " + mark + " ", cursor | (curses.color_pair(C_SEL) if it.selected else 0))
                self.put(y, 6, star + " ", cursor | curses.color_pair(C_SUGG) | curses.A_BOLD)
                self.put(y, 8, fit(it.label, lw) + " ", cursor | label_attr)
                self.put(y, 8 + lw + 1, fit(size, 8, ">"),
                         cursor | (curses.color_pair(C_BIG) | curses.A_BOLD if big else 0))
                note = "LỖI" if it.error else it.note
                bad = it.error or it.extra.get("bad")
                self.put(y, 8 + lw + 9, "  " + fit(note, nw) + " ",
                         cursor | curses.color_pair(C_WARN if bad else C_DIM))

        # thanh dưới
        self.put(h - 3, 0, "─" * (w - 1), curses.color_pair(C_DIM))
        if self.msg:
            self.put(h - 2, 1, fit(self.msg, w - 2),
                     curses.color_pair(C_WARN if self.msg_warn else C_SUGG) | curses.A_BOLD)
        elif rows:
            kind, obj, _ = rows[self.cur]
            text = GROUP_DESC[obj] if kind == "h" else (f"Lỗi: {obj.error}" if obj.error else obj.detail)
            self.put(h - 2, 1, fit(text, w - 2), curses.color_pair(C_DIM))
        sel = [i for i in self.items if i.selected and not i.deleted]
        if self.startup:
            left = f" Đã chọn {len(sel)} mục "
            fast = " f tắt nhanh "
            keys = " Space chọn  s gợi ý  d tắt  e bật lại  i chi tiết  Tab dung lượng  r quét lại  q thoát"
        else:
            left = f" Đã chọn {len(sel)} mục · {human(sum(i.size or 0 for i in sel))} "
            fast = " f dọn nhanh "
            keys = " Space chọn  a cả nhóm  s gợi ý  d xoá  i chi tiết  Tab khởi động  r quét lại  q thoát"
        self.put(h - 1, 0, left, curses.A_REVERSE | curses.A_BOLD)
        self.put(h - 1, len(left) + 1, fast, curses.A_REVERSE | curses.A_BOLD | curses.color_pair(C_SUGG))
        x = len(left) + 1 + len(fast)
        self.put(h - 1, x, fit(keys, w - x - 1), curses.color_pair(C_DIM))
        scr.refresh()

    # ── hộp thoại ──
    def popup(self, lines, color=C_WARN, bold=()):
        """Hiện hộp thoại giữa màn hình, chờ một phím và trả về phím đó."""
        h, w = self.scr.getmaxyx()
        bw = min(w - 4, 90)
        lines = lines[:max(1, h - 4)]
        bh = len(lines) + 2
        win = curses.newwin(bh, bw, max(0, (h - bh) // 2), max(0, (w - bw) // 2))
        win.bkgd(" ", curses.color_pair(0))
        win.erase()
        win.attron(curses.color_pair(color))
        win.border()
        win.attroff(curses.color_pair(color))
        for n, line in enumerate(lines):
            try:
                win.addstr(1 + n, 2, fit(line, bw - 4), curses.A_BOLD if n in bold or n - len(lines) in bold else 0)
            except curses.error:
                pass
        win.refresh()
        self.scr.timeout(-1)
        try:
            k = self.scr.get_wch()
        except curses.error:
            k = None
        finally:
            self.scr.timeout(250)
        return k

    def confirm(self, head, entries, notes):
        h, w = self.scr.getmaxyx()
        maxn = max(1, min(len(entries), h - 12))
        lines = [head, ""] + entries[:maxn]
        if len(entries) > maxn:
            lines.append(f"   … và {len(entries) - maxn} mục khác")
        lines += [""] + notes
        return self.popup(lines, bold=(0, -1, -2)) in ("y", "Y")

    def show_info(self, it):
        bw = min(self.scr.getmaxyx()[1] - 4, 90) - 4
        if it.extra.get("info"):
            facts = it.extra["info"]
        elif it.kind == "info":
            facts = [("Chi tiết", it.detail), ("RAM", human(it.size) if it.size else "—"), ("Ghi chú", it.note)]
        else:
            facts = [("Đường dẫn", it.detail), ("Dung lượng", human(it.size)), ("Ghi chú", it.note or "—"),
                     ("Gợi ý xoá", "có" if it.suggested else "không")]
        lines = [it.label, ""]
        for k, val in facts + ([("Lỗi", it.error)] if it.error else []):
            lines += textwrap.wrap(f"{k}: {val}", bw, subsequent_indent="    ", break_on_hyphens=False) or [k]
        lines += ["", "Nhấn phím bất kỳ để đóng."]
        self.popup(lines, color=C_HEAD, bold=(0,))

    # ── xoá ──
    def delete_selected(self):
        sel = [i for i in self.items if i.selected and not i.deleted]
        if not sel:
            self.set_msg("Chưa chọn mục nào (Space để chọn, s để chọn các mục gợi ý).", warn=True)
            return
        if self.scanning:
            self.set_msg("Đang quét, đợi quét xong rồi xoá nhé.", warn=True)
            return
        bw = min(self.scr.getmaxyx()[1] - 4, 90)
        entries = [f" • {fit(i.label, bw - 16)} {fit(human(i.size), 8, '>')}" for i in sel]
        notes = ["(DRY-RUN: không xoá thật)" if self.dry else "Thao tác này KHÔNG hoàn tác được.",
                 "Nhấn  y  để xoá, phím bất kỳ để huỷ."]
        if not self.confirm(f"Xoá {len(sel)} mục, khoảng {human(sum(i.size or 0 for i in sel))}?", entries, notes):
            self.set_msg("Đã huỷ.")
            return
        if self.dry:
            for i in sel:
                i.selected = False
            self.set_msg(f"DRY-RUN: sẽ xoá {len(sel)} mục, khoảng {human(sum(i.size or 0 for i in sel))}.")
            return
        def progress(n, total, it):
            self.set_msg(f"[{n}/{total}] Đang xoá: {it.label} ({human(it.size)})…")
            self.draw()

        ok, fail, freed = delete_items(sel, progress)
        self.items = [i for i in self.items if not i.deleted]
        self.sys.refresh_async()
        msg = f"Đã xoá {ok} mục, giải phóng khoảng {human(freed)}."
        if fail:
            msg += f" {fail} mục lỗi (tô đỏ, đưa con trỏ vào để xem chi tiết)."
        self.set_msg(msg, warn=bool(fail))

    # ── tắt / bật lại mục khởi động ──
    def ask_sudo(self):
        curses.def_prog_mode()
        curses.endwin()
        print("\nmacclean cần quyền quản trị (sudo) để tắt / bật dịch vụ hệ thống.", flush=True)
        try:
            ok = subprocess.run(["sudo", "-v"]).returncode == 0
        except (OSError, KeyboardInterrupt):
            ok = False
        curses.reset_prog_mode()
        self.scr.refresh()
        return ok

    def toggle_selected(self, enable):
        want = "off" if enable else "on"
        sel = [i for i in self.items if i.selected and i.kind in ACTION_KINDS and i.extra["state"] == want]
        if not sel:
            self.set_msg("Chọn các mục 'đã tắt' (Space) rồi nhấn e để bật lại." if enable else
                         "Chưa chọn mục nào đang bật (Space để chọn, s để chọn các mục nên tắt).", warn=True)
            return
        if self.scanning:
            self.set_msg("Đang quét, đợi quét xong nhé.", warn=True)
            return
        verb = "Bật lại" if enable else "Tắt"
        key = "on" if enable else "off"
        root = any(r for i in sel for _, _, r in i.extra[key])
        bw = min(self.scr.getmaxyx()[1] - 4, 90)
        entries = [f" • {fit(i.label, bw - 30)}  {fit(GROUP_TITLE[i.group].split(' ·')[0], 20)}" for i in sel]
        notes = ["(DRY-RUN: không thay đổi gì)" if self.dry else
                 "Chạy lại ngay và ở lần đăng nhập sau." if enable else
                 "Mở lại bất cứ lúc nào: chọn mục rồi nhấn e (hoặc xem i / macclean --startup)."]
        if root and not self.dry:
            notes.append("Có mục hệ thống — sẽ hỏi mật khẩu admin (sudo).")
        notes.append(f"Nhấn  y  để {verb.lower()}, phím bất kỳ để huỷ.")
        if not self.confirm(f"{verb} {len(sel)} mục khởi động?", entries, notes):
            self.set_msg("Đã huỷ.")
            return
        if self.dry:
            for i in sel:
                i.selected = False
            self.set_msg(f"DRY-RUN: sẽ {verb.lower()} {len(sel)} mục.")
            return

        def progress(n, total, it):
            self.set_msg(f"[{n}/{total}] {verb}: {it.label}…")
            self.draw()

        ok, fail = toggle_items(sel, enable, progress, self.ask_sudo)
        errs = [f"{i.label}: {i.error}" for i in sel if i.error]
        msg = f"Đã {verb.lower()} {ok} mục." + (" Xem lại cách mở lại: i trên từng mục." if ok and not enable else "")
        if fail:
            msg += f" {fail} lỗi — {errs[0]}"
        self.start_scan(keep=True, done_msg=(msg, bool(fail)))

    # ── xử lý phím ──
    def handle(self, k):
        rows = self.rows()
        H = max(1, self.scr.getmaxyx()[0] - 6)
        cur = rows[self.cur] if rows and self.cur < len(rows) else None
        if k not in (curses.KEY_RESIZE,):
            if not self.scanning and not self.msg.startswith("["):
                self.msg = ""
        selectable = (lambda i: i.kind != "info")

        if k in ("q", "Q"):
            return False
        elif k in ("\t", curses.KEY_BTAB):
            self.switch("startup" if self.v.key == "disk" else "disk")
        elif k in ("1", "2"):
            self.switch("disk" if k == "1" else "startup")
        elif k in (curses.KEY_UP, "k"):
            self.cur -= 1
        elif k in (curses.KEY_DOWN, "j"):
            self.cur += 1
        elif k == curses.KEY_PPAGE:
            self.cur -= H
        elif k == curses.KEY_NPAGE:
            self.cur += H
        elif k in (curses.KEY_HOME, "g"):
            self.cur = 0
        elif k in (curses.KEY_END, "G"):
            self.cur = len(rows) - 1
        elif k == " " and cur:
            kind, obj, its = cur
            if kind == "h":
                its = [i for i in its if selectable(i)]
                state = not all(i.selected for i in its)
                for i in its:
                    i.selected = state
            elif not selectable(obj):
                self.set_msg(obj.detail or "Mục thông tin — không chọn được.")
                self.cur += 1
            else:
                obj.selected = not obj.selected
                self.cur += 1
        elif k in ("i", "I", "?") and cur:
            kind, obj, _ = cur
            if kind == "h":
                self.set_msg(GROUP_DESC[obj])
            else:
                self.show_info(obj)
        elif k in ("\n", "\r", curses.KEY_ENTER, curses.KEY_RIGHT, curses.KEY_LEFT, "l", "h") and cur:
            kind, obj, _ = cur
            key = obj if kind == "h" else obj.group
            if k in (curses.KEY_RIGHT, "l"):
                self.collapsed.discard(key)
            elif k in (curses.KEY_LEFT, "h") or key not in self.collapsed:
                self.collapsed.add(key)
                self.cur = next(n for n, r in enumerate(self.rows()) if r[0] == "h" and r[1] == key)
            else:
                self.collapsed.discard(key)
        elif k == "a" and cur:
            kind, obj, _ = cur
            key = obj if kind == "h" else obj.group
            its = [i for i in self.items if i.group == key and not i.deleted and visible(i) and selectable(i)]
            state = not all(i.selected for i in its)
            for i in its:
                i.selected = state
        elif k == "f":
            what = "tắt nhanh" if self.startup else "dọn nhanh"
            if self.scanning:
                self.set_msg(f"Đang quét, đợi quét xong rồi {what} nhé.", warn=True)
            elif not any(i.suggested and visible(i) and not i.deleted for i in self.items):
                self.set_msg(f"Không có mục gợi ý nào để {what}.")
            else:
                for i in self.items:
                    if i.suggested and visible(i) and not i.deleted:
                        i.selected = True
                self.toggle_selected(False) if self.startup else self.delete_selected()
        elif k == "c":
            keys = {i.group for i in self.items}
            self.collapsed = set() if self.collapsed >= keys else keys
        elif k == "s":
            n = 0
            for i in self.items:
                if i.suggested and visible(i) and not i.deleted:
                    n += not i.selected
                    i.selected = True
            self.set_msg(f"Đã chọn thêm {n} mục gợi ý (*)." if n else "Không có mục gợi ý nào chưa chọn.")
        elif k == "u":
            for i in self.items:
                i.selected = False
        elif k in ("d", "D", "x", curses.KEY_DC):
            self.toggle_selected(False) if self.startup else self.delete_selected()
        elif k in ("e", "E"):
            if self.startup:
                self.toggle_selected(True)
            else:
                self.set_msg("Phím e (bật lại) dùng ở tab 2 Khởi động & hiệu năng.")
        elif k in ("r", "R"):
            self.start_scan(keep=self.startup)
        return True

    def loop(self):
        curses.curs_set(0)
        curses.use_default_colors()
        for pair, fg in ((C_SUGG, curses.COLOR_GREEN), (C_BIG, curses.COLOR_YELLOW),
                         (C_WARN, curses.COLOR_RED), (C_SEL, curses.COLOR_CYAN),
                         (C_DIM, 8 if curses.COLORS > 8 else curses.COLOR_WHITE),
                         (C_HEAD, curses.COLOR_BLUE)):
            curses.init_pair(pair, fg, -1)
        self.scr.keypad(True)
        self.scr.timeout(250)
        self.start_scan()
        while True:
            self.draw()
            try:
                k = self.scr.get_wch()
            except curses.error:
                continue
            if self.handle(k) is False:
                break


# ───────────────────────────── chế độ báo cáo ─────────────────────────────

def scan_sized():
    print("Đang quét…", file=sys.stderr)
    items = scan_all()
    with ThreadPoolExecutor(max_workers=8) as pool:
        list(pool.map(fill_size, items))
    return items


def quick(dry_run=False, yes=False):
    """Dọn nhanh các mục gợi ý (*) không cần mở TUI."""
    sel = [i for i in scan_sized() if i.suggested and visible(i)]
    if not sel:
        print("Không có mục gợi ý nào để dọn — máy đang gọn gàng.")
        return
    total = sum(i.size or 0 for i in sel)
    for key, title, _ in GROUPS:
        its = [i for i in sel if i.group == key]
        if its:
            print(f"\n▾ {title}  —  {len(its)} mục · {human(sum(i.size or 0 for i in its))}")
            for i in its:
                print(f"    {fit(i.label, 58)} {fit(human(i.size), 8, '>')}")
    print(f"\nDọn nhanh: {len(sel)} mục · khoảng {human(total)}")
    if dry_run:
        print("DRY-RUN: không xoá gì.")
        return
    if not yes:
        try:
            ans = input("Xoá các mục trên? Thao tác này không hoàn tác được. [y/N] ")
        except EOFError:
            ans = ""
        if ans.strip().lower() not in ("y", "yes", "c", "có"):
            print("Đã huỷ.")
            return
    ok, fail, freed = delete_items(
        sel, lambda n, t, it: print(f"[{n}/{t}] Đang xoá: {it.label} ({human(it.size)})", flush=True))
    for i in sel:
        if i.error:
            print(f"  LỖI · {i.label}: {i.error}", file=sys.stderr)
    print(f"\nĐã xoá {ok} mục, giải phóng khoảng {human(freed)}." + (f" {fail} mục lỗi." if fail else ""))


def report():
    items = scan_sized()
    sinfo = SysInfo()
    sinfo.refresh()
    print(" │ ".join(t for t, _ in sinfo.parts))
    grand = sugg_total = 0
    for key, title, _ in GROUPS:
        its = [i for i in items if i.group == key and visible(i)]
        if not its:
            continue
        if key in SORT_BY_SIZE:
            its.sort(key=lambda i: i.size or 0, reverse=True)
        total = sum(i.size or 0 for i in its)
        grand += total
        print(f"\n▾ {title}  —  {len(its)} mục · {human(total)}")
        for i in its:
            sugg_total += (i.size or 0) if i.suggested else 0
            print(f"  {'*' if i.suggested else ' '} {fit(i.label, 56)} {fit(human(i.size), 8, '>')}  {i.note}")
    print(f"\nTổng: {human(grand)} · Gợi ý (*) có thể xoá: {human(sugg_total)}")


def startup_report():
    print("Đang quét…", file=sys.stderr)
    items = scan_startup()
    sinfo = SysInfo()
    sinfo.refresh()
    print(" │ ".join(t for t, _ in sinfo.parts))
    nsug = 0
    for key, title, _ in STARTUP_GROUPS:
        its = [i for i in items if i.group == key]
        if not its:
            continue
        print(f"\n▾ {title}")
        for i in its:
            nsug += i.suggested
            size = human(i.size) if i.size else ""
            print(f"  {'*' if i.suggested else ' '} {fit(i.label, 54)} {fit(size, 8, '>')}  {i.note}")
            if i.kind == "info":
                print(f"      {i.detail}")
                continue
            if i.extra["reason"] and i.suggested:
                print(f"      vì sao: {i.extra['reason']}")
            if i.extra["state"] == "off":
                print(f"      mở lại: {i.extra['hint'] or steps_text(i.extra['on']) or 'không tự mở lại được'}")
    print(f"\n* = nên tắt ({nsug} mục). Tắt / bật lại: mở macclean, nhấn Tab, chọn mục rồi nhấn d (tắt) hoặc e (bật lại).")
    print(f"Lịch sử các mục macclean đã tắt: {STATE_FILE}")


def main():
    ap = argparse.ArgumentParser(prog="macclean", description="TUI dọn dẹp dung lượng cho máy Mac dev.")
    ap.add_argument("--dry-run", action="store_true", help="chạy thử, không xoá thật")
    ap.add_argument("--list", action="store_true", help="in báo cáo rồi thoát (không mở TUI)")
    ap.add_argument("--quick", action="store_true", help="dọn nhanh các mục gợi ý (*) không cần TUI")
    ap.add_argument("-y", "--yes", action="store_true", help="dùng với --quick: không hỏi xác nhận")
    ap.add_argument("--startup", action="store_true",
                    help="in báo cáo khởi động & hiệu năng (kèm lệnh mở lại) rồi thoát")
    ap.add_argument("--tab", choices=("disk", "startup"), default="disk",
                    help="tab mở sẵn khi vào TUI (mặc định: disk)")
    args = ap.parse_args()
    if args.yes and not args.quick:
        ap.error("--yes chỉ dùng cùng --quick")
    if sys.platform != "darwin":
        sys.exit("macclean chỉ chạy trên macOS.")
    if args.list:
        return report()
    if args.startup:
        return startup_report()
    if args.quick:
        return quick(args.dry_run, args.yes)
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(lambda scr: App(scr, args.dry_run, args.tab).loop())
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
