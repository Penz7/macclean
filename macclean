class Procs:
    """Ảnh chụp danh sách tiến trình: pid → (ppid, rss, %cpu, đường dẫn)."""

    def __init__(self):
        self.by_pid, self.kids = {}, {}
        for line in run(["ps", "-Axo", "pid=,ppid=,rss=,pcpu=,comm="]).stdout.splitlines():
            parts = line.split(None, 4)
            if len(parts) < 5:
                continue
            try:
                pid, ppid, rss = int(parts[0]), int(parts[1]), int(parts[2]) * 1024
                cpu = float(parts[3].replace(",", "."))
            except ValueError:
                continue
            self.by_pid[pid] = (ppid, rss, cpu, parts[4])
            self.kids.setdefault(ppid, []).append(pid)

    def rss(self, pid):
        """RAM của pid cộng mọi tiến trình con."""
        total, stack, seen = 0, [pid] if pid and pid > 1 else [], set()
        while stack:
            p = stack.pop()
            if p in seen or p not in self.by_pid:
                continue
            seen.add(p)
            total += self.by_pid[p][1]
            stack += self.kids.get(p, [])
        return total


def swap_usage():
    m = re.search(r"total = ([\d.,]+)M\s+used = ([\d.,]+)M", run(["sysctl", "-n", "vm.swapusage"]).stdout)
    if not m:
        return None
    total, used = (float(x.replace(",", ".")) * (1 << 20) for x in m.groups())
    return used, total


def cpu_speed_limit():
    m = re.search(r"CPU_Speed_Limit\s*=\s*(\d+)", run(["pmset", "-g", "therm"]).stdout)
    return int(m.group(1)) if m else None


def uptime_days():
    m = re.search(r"sec = (\d+)", run(["sysctl", "-n", "kern.boottime"]).stdout)
    return (time.time() - int(m.group(1))) / DAY if m else None


def diagnostics():
    """Các dấu hiệu khiến máy lag: (nhãn, ghi chú, giải thích)."""
    out = []
    ncpu = os.cpu_count() or 1
    l1, l5, _ = os.getloadavg()
    if max(l1, l5) > ncpu:
        out.append((f"Tải CPU {l1:.0f} · {l5:.0f} (1 · 5 phút), máy chỉ có {ncpu} luồng", "quá tải",
                    "Nhiều tiến trình tranh CPU hơn số luồng nên mọi thứ phải xếp hàng — xem các app nặng bên dưới."))
    sw = swap_usage()
    if sw and sw[0] > GIB and sw[0] / sw[1] > 0.5:
        out.append((f"Swap {sw[0] / GIB:.1f}/{sw[1] / GIB:.1f}G — RAM không đủ", "nên khởi động lại",
                    "Máy phải đẩy dữ liệu RAM xuống ổ đĩa rồi đọc lại nên giật, lag. Xoá file không giúp được; "
                    "swap chỉ được trả lại khi khởi động lại máy — và nên đóng bớt app nặng bên dưới."))
    lim = cpu_speed_limit()
    if lim is not None and lim < 100:
        out.append((f"CPU chỉ được chạy {lim}% tốc độ", "máy nóng",
                    "macOS đang hạ xung để giảm nhiệt (CPU_Speed_Limit). Kê máy thoáng, vệ sinh quạt, "
                    "tránh build nặng liên tục."))
    up = uptime_days()
    if up is not None and up >= 7:
        out.append((f"Máy đã bật {up:.0f} ngày chưa khởi động lại", "nên khởi động lại",
                    "Khởi động lại để giải phóng swap, cache và các tiến trình bị kẹt."))
    return out


def app_name(path):
    m = re.search(r"/([^/]+)\.app/", path)
    return m.group(1) if m else os.path.basename(path)


def proc_group(path):
    for rx, name, tip in PROC_RULES:
        if rx.search(path):
            return name or app_name(path), tip
    return app_name(path), ""


def scan_perf(procs: Procs):
    items = [Item("perf", label, "", kind="info", size=0, note=note, detail=why, extra={"warn": True})
             for label, note, why in diagnostics()]
    if not items:
        items.append(Item("perf", "Tải CPU, RAM và nhiệt độ đang bình thường", "", kind="info", size=0,
                          note="ổn", detail="Không thấy dấu hiệu quá tải lúc quét."))
    groups = {}
    me = os.getpid()
    for pid, (_, rss, cpu, path) in procs.by_pid.items():
        if pid == me:
            continue
        name, tip = proc_group(path)
        g = groups.setdefault(name, [0, 0.0, 0, tip])
        g[0] += rss
        g[1] += cpu
        g[2] += 1
    heavy = sorted(((n, g) for n, g in groups.items() if g[0] >= 300 << 20 or g[1] >= 20),
                   key=lambda x: x[1][0], reverse=True)
    for name, (rss, cpu, n, tip) in heavy[:12]:
        items.append(Item("perf", f"{name} · {n} tiến trình" if n > 1 else name, "", kind="info", size=rss,
                          note=f"CPU {cpu:.0f}%",
                          detail=tip or "Đang dùng nhiều RAM / CPU — thoát nếu không cần.",
                          extra={"warn": cpu >= 50 or rss >= 1.5 * GIB}))
    return items


def advice(name, broken=None):
    """(có nên tắt không, lý do) cho một mục tự chạy."""
    if broken:
        return True, f"Hỏng: không còn {broken} — mỗi lần đăng nhập vẫn chạy rồi lỗi."
    for rx, why in KEEP_RULES:
        if rx.search(name):
            return False, why
    if UPDATER_RE.search(name):
        if BROWSER_RE.search(name):
            return False, "Trình cập nhật của trình duyệt — nên giữ để nhận bản vá bảo mật."
        return True, "Chỉ để tự cập nhật chạy nền — ứng dụng vẫn kiểm tra cập nhật khi bạn mở nó."
    return False, ""


def steps_text(steps):
    """Một bước = [argv, bắt buộc thành công?, cần sudo?]; "@docker" là bước nội bộ của macclean."""
    out = []
    for argv, _, root in steps:
        if argv[0] == "@docker":
            out.append(f"macclean đặt AutoStart={argv[1]} trong cài đặt Docker")
        else:
            out.append(("sudo " if root else "") + shlex.join(argv))
    return " && ".join(out)


def startup_item(group, label, kind, *, rid, off, on_steps, off_steps, reason="", status="", size=0,
                 suggested=False, facts=(), hint="", **extra):
    reopen = hint or steps_text(on_steps) or "không tự mở lại được"
    status = status or ("đã tắt" if off else "bật")
    detail = f"Đã tắt · mở lại: chọn rồi nhấn e, hoặc {reopen}" if off else \
        (reason or f"Nếu tắt, mở lại bằng: {reopen}")
    info = [("Trạng thái", status), *[tuple(f) for f in facts], ("Nhận xét", reason or "—")]
    if off_steps:
        info.append(("Tắt bằng", steps_text(off_steps)))
    info.append(("Mở lại bằng", reopen + (" (hoặc chọn mục này rồi nhấn e)" if on_steps else "")))
    return Item(group, label, rid, kind=kind, detail=detail, note=status, size=size, suggested=suggested and not off,
                extra={"id": rid, "state": "off" if off else "on", "on": on_steps, "off": off_steps,
                       "reason": reason, "facts": [list(f) for f in facts], "hint": hint, "info": info,
                       "bad": status.startswith(("hỏng", "lỗi")), **extra})


def missing_program(pl):
    """Đường dẫn chương trình / script mà plist trỏ tới nhưng không còn tồn tại."""
    args = [a for a in pl.get("ProgramArguments") or [] if isinstance(a, str)]
    prog = pl.get("Program") or (args[0] if args else "")
    if prog.startswith("/") and not os.path.exists(prog):
        return prog
    if os.path.basename(prog).rstrip("0123456789.") in INTERPRETERS:
        for a in args[1:]:
            if a.startswith("-"):
                continue
            if a.startswith("/") and not os.path.exists(a):
                return a
            break
    return None


def launchctl_disabled(domain):
    out = run(["launchctl", "print-disabled", domain]).stdout
    return {m.group(1) for m in re.finditer(r'"([^"]+)" => (?:disabled|true)', out)}


def launchctl_jobs():
    """label → (pid, mã thoát gần nhất) của các job đã nạp trong domain gui của user."""
    jobs = {}
    for line in run(["launchctl", "list"]).stdout.splitlines()[1:]:
        parts = line.split("\t")
        if len(parts) == 3:
            jobs[parts[2]] = (int(parts[0]) if parts[0].isdigit() else None, parts[1])
    return jobs


def launchctl_print(target):
    r = run(["launchctl", "print", target], timeout=10)
    if r.returncode:
        return None
    pid = re.search(r"^\tpid = (\d+)$", r.stdout, re.M)
    code = re.search(r"^\tlast exit code = (-?\d+)", r.stdout, re.M)
    return int(pid.group(1)) if pid else None, code.group(1) if code else "-"


def scan_launchd(procs: Procs, brew_managed):
    items = []
    jobs = launchctl_jobs()
    disabled = {f"gui/{UID}": launchctl_disabled(f"gui/{UID}"), "system": launchctl_disabled("system")}
    for base, dom in ((HOME / "Library/LaunchAgents", f"gui/{UID}"),
                      (Path("/Library/LaunchAgents"), f"gui/{UID}"),
                      (Path("/Library/LaunchDaemons"), "system")):
        for plist in sorted(base.glob("*.plist")):
            pl = read_plist(plist)
            label = pl.get("Label") or plist.stem
            if label.startswith("com.apple.") or label in brew_managed:
                continue
            system = dom == "system"
            file_root = HOME not in plist.parents        # plist ngoài home: chuyển file cần sudo
            job = launchctl_print(f"system/{label}") if system else jobs.get(label)
            pid, code = job or (None, None)
            off = label in disabled[dom]
            missing = missing_program(pl)
            tgt = f"{dom}/{label}"
            off_steps = [[["launchctl", "bootout", tgt], False, system],
                         [["launchctl", "disable", tgt], True, system]]
            extra = {}
            if missing:  # plist hỏng: cất vào thư mục backup thay vì để chạy lỗi mãi
                extra = {"moved_to": str(BACKUP_DIR / plist.name), "plist": str(plist), "file_root": file_root}
                off_steps.append([["mv", str(plist), extra["moved_to"]], True, file_root])
            on_steps = [[["launchctl", "enable", tgt], True, system],
                        [["launchctl", "bootstrap", dom, str(plist)], False, system]]
            if off:
                status = "đã tắt"
            elif missing:
                status = "hỏng"
            elif pid:
                status = "đang chạy"
            elif code and code not in ("0", "-"):
                status = f"lỗi (exit {code})"
            else:
                status = "chờ" if job else "chưa nạp"
            sugg, reason = advice(label, missing)
            args = pl.get("ProgramArguments") or [pl.get("Program", "")]
            items.append(startup_item(
                "daemon" if system else "agent", label, "launchd", rid=f"launchd:{tgt}", off=off,
                on_steps=on_steps, off_steps=off_steps, reason=reason, status=status,
                size=procs.rss(pid), suggested=sugg,
                facts=[("File", str(plist)), ("Chương trình", " ".join(map(str, args))), ("Domain", tgt)],
                **extra))
    return items


def scan_brew(procs: Procs):
    """Trả về (các mục brew services, tập label launchd do brew quản lý)."""
    if not shutil.which("brew"):
        return [], set()
    try:
        data = json.loads(run(["brew", "services", "info", "--all", "--json"], timeout=120).stdout) or []
    except ValueError:
        data = []
    items, managed = [], set()
    names = {"started": "đang chạy", "error": "lỗi", "scheduled": "chờ", "stopped": "đã dừng"}
    state = load_state()
    for s in data:
        name = s.get("name") or ""
        status = s.get("status") or "none"
        on = status != "none" or bool(s.get("running"))
        if on or s.get("loaded"):
            managed |= {s.get("service_name") or "", f"homebrew.mxcl.{name}", Path(s.get("file") or "x").stem}
        root = s.get("user") == "root"
        rid = f"brew:{name}"
        dev = bool(DEV_SERVICE_RE.search(name))
        items.append(startup_item(
            "brew", name, "brew", rid=rid, off=not on,
            on_steps=[[["brew", "services", "start", name], True, root]],
            off_steps=[[["brew", "services", "stop", name], True, root]],
            reason="Dịch vụ dev chạy nền suốt — chỉ bật khi đang làm project cần nó." if dev
            else "Dịch vụ Homebrew chạy nền.",
            status=names.get(status, status) if on else ("đã tắt" if rid in state else "không chạy"),
            size=procs.rss(s.get("pid")), suggested=on and dev,
            facts=[("Lệnh", s.get("command") or s.get("file") or "")] + ([("Chạy bằng", "root")] if root else [])))
    return items, managed


LOGIN_SCRIPT = """tell application "System Events"
set out to ""
repeat with li in login items
set out to out & (name of li) & tab & (path of li) & tab & (hidden of li) & linefeed
end repeat
return out
end tell"""
DOCKER_DIR = HOME / "Library/Group Containers/group.com.docker"
LOGIN_HINT = "Cài đặt hệ thống → Chung → Mục đăng nhập → bấm + và chọn lại app"


def as_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def docker_setting():
    for fn, key in (("settings-store.json", "AutoStart"), ("settings.json", "autoStart")):
        p = DOCKER_DIR / fn
        try:
            data = json.loads(p.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(data, dict) and key in data:
            return p, key, data
    return None


def set_docker_autostart(value):
    found = docker_setting()
    if not found:
        return "không tìm thấy file cài đặt của Docker Desktop"
    p, key, data = found
    data[key] = value
    tmp = p.with_name(p.name + ".macclean-tmp")
    try:
        tmp.write_text(json.dumps(data, indent=2))
        os.replace(tmp, p)
    except OSError as e:
        return str(e)
    return None


def scan_login(procs: Procs):
    items = []
    r = run(["osascript", "-e", LOGIN_SCRIPT], timeout=30)
    if r.returncode:
        items.append(Item("login", "Không đọc được Mục đăng nhập", "", kind="info", size=0, note="cần quyền",
                          detail="Cấp quyền: Cài đặt → Quyền riêng tư & Bảo mật → Tự động hoá → cho terminal "
                                 "điều khiển System Events."))
    for line in r.stdout.splitlines() if not r.returncode else []:
        name, path, hidden = (line.split("\t") + ["", ""])[:3]
        if not name:
            continue
        path = "" if path == "missing value" else path
        broken = None if path and os.path.exists(path) else (path or "ứng dụng gốc")
        sugg, reason = advice(name, broken)
        off_steps = [[["osascript", "-e",
                       f'tell application "System Events" to delete login item {as_str(name)}'], True, False]]
        on_steps = [[["osascript", "-e",
                      f'tell application "System Events" to make login item at end with properties '
                      f'{{path:{as_str(path)}, hidden:{"true" if hidden == "true" else "false"}}}'],
                     True, False]] if path else []
        items.append(startup_item(
            "login", name, "login", rid=f"login:{name}", off=False, on_steps=on_steps, off_steps=off_steps,
            reason=reason, status="hỏng" if broken else "bật", suggested=sugg,
            facts=[("Ứng dụng", path or "(không còn)")],
            hint="" if path else "không mở lại được — ứng dụng đã bị gỡ; cài lại rồi " + LOGIN_HINT))

    found = docker_setting()
    if found:
        p, key, data = found
        on = bool(data[key])
        running = any("/Docker.app/" in v[3] for v in procs.by_pid.values())
        items.append(startup_item(
            "login", "Docker Desktop · tự mở khi đăng nhập", "docker", rid="docker:autostart", off=not on,
            on_steps=[[["@docker", "true"], True, False]], off_steps=[[["@docker", "false"], True, False]],
            reason="Docker giữ máy ảo vài GB RAM ngay khi mở — chỉ mở Docker khi cần."
                   + (" Docker đang mở: nên Quit Docker trước, kẻo nó ghi đè cài đặt." if running else ""),
            status="bật" if on else "đã tắt", suggested=on,
            facts=[("File", f"{p} ({key})")],
            hint="Docker Desktop → Settings → General → Start Docker Desktop when you sign in"))
    return items


def load_state():
    try:
        data = json.loads(STATE_FILE.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_name(STATE_FILE.name + ".tmp")
    tmp.write_text(json.dumps(state, ensure_ascii=False, indent=2))
    os.replace(tmp, STATE_FILE)


def scan_startup():
    procs = Procs()
    brew, managed = scan_brew(procs)
    items = brew + scan_login(procs) + scan_launchd(procs, managed)
    # Mục đã tắt mà không còn thấy trên máy (login item đã gỡ, plist hỏng đã cất đi) → lấy từ lịch sử
    state = load_state()
    present = {it.extra["id"]: it for it in items}
    changed = False
    for rid, rec in list(state.items()):
        it = present.get(rid)
        if it is None:
            items.append(startup_item(
                rec["group"], rec["label"], rec["kind"], rid=rid, off=True, on_steps=rec["on"], off_steps=[],
                reason=rec.get("reason", ""), facts=rec.get("facts", []) + [["Tắt lúc", rec.get("when", "?")]],
                hint=rec.get("hint", "")))
        elif it.extra["state"] == "on":
            del state[rid]  # đã được bật lại bên ngoài macclean
            changed = True
        else:
            it.extra["info"].insert(1, ("Tắt lúc", rec.get("when", "?")))
    if changed:
        save_state(state)
    items.sort(key=lambda i: (not i.suggested, i.extra["state"] == "off", i.label.lower()))
    return scan_perf(procs) + items


def sudo_ready(prompt=None):
    if run(["sudo", "-n", "true"]).returncode == 0:
        return True
    return bool(prompt and prompt())


def run_steps(steps):
    """Chạy các bước; trả về None nếu thành công, ngược lại là thông báo lỗi."""
    for argv, required, root in steps:
        if argv[0] == "@docker":
            err = set_docker_autostart(argv[1] == "true")
        else:
            r = run((["sudo", "-n"] if root else []) + argv, timeout=180)
            err = None if r.returncode == 0 else \
                ((r.stderr.strip() or r.stdout.strip()).splitlines() or [f"exit {r.returncode}"])[-1]
        if err and required:
            return f"{steps_text([[argv, required, root]])}: {err}"
    return None


def toggle_items(items, enable, progress=None, sudo_prompt=None):
    """Tắt (enable=False) hoặc bật lại các mục khởi động; trả về (số thành công, số lỗi)."""
    key = "on" if enable else "off"
    need_root = any(root for it in items for _, _, root in it.extra[key])
    have_root = not need_root or sudo_ready(sudo_prompt)
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    state = load_state()
    ok = fail = 0
    for n, it in enumerate(items, 1):
        if progress:
            progress(n, len(items), it)
        steps = it.extra[key]
        if not steps:
            err = it.extra.get("hint") or "không tự mở lại được — hãy bật lại thủ công"
        elif not have_root and any(root for _, _, root in steps):
            err = "cần mật khẩu admin (sudo) — đã bỏ qua"
        else:
            err = run_steps(steps)
        it.selected = False
        if err:
            it.error = err
            fail += 1
            continue
        ok += 1
        it.error = ""
        rid = it.extra["id"]
        if enable:
            state.pop(rid, None)
        elif it.extra["on"] or it.extra.get("moved_to"):  # chỉ ghi mục còn bật lại được
            on = it.extra["on"]
            if it.extra.get("moved_to"):  # plist đã được cất đi: bật lại thì chuyển về chỗ cũ trước
                on = [[["mv", it.extra["moved_to"], it.extra["plist"]], True, it.extra["file_root"]]] + on
            state[rid] = {"group": it.group, "label": it.label, "kind": it.kind, "on": on,
                          "reason": it.extra["reason"], "facts": it.extra["facts"], "hint": it.extra["hint"],
                          "when": datetime.now().strftime("%d/%m/%Y %H:%M")}
        it.extra["state"] = key
    save_state(state)
    return ok, fail


