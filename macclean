def newest_mtime(p: Path):
    """mtime mới nhất của p và các mục con trực tiếp (đủ để biết thư mục còn được dùng không)."""
    try:
        st = p.lstat()
    except OSError:
        return None
    newest = st.st_mtime
    if stat.S_ISDIR(st.st_mode):
        try:
            for c in os.scandir(p):
                try:
                    newest = max(newest, c.stat(follow_symlinks=False).st_mtime)
                except OSError:
                    pass
        except OSError:
            pass
    return newest


def old_children(dirs, days, skip=()):
    """Các mục con (cấp 1) của dirs không thay đổi trong `days` ngày, thuộc user hiện tại."""
    cutoff = time.time() - days * DAY
    out = []
    for d in dirs:
        try:
            entries = list(os.scandir(d))
        except OSError:
            continue
        for e in entries:
            if e.name.startswith(skip):
                continue
            try:
                st = e.stat(follow_symlinks=False)
            except OSError:
                continue
            if stat.S_ISSOCK(st.st_mode) or st.st_uid != os.getuid():
                continue
            m = newest_mtime(Path(e.path))
            if m is not None and m < cutoff:
                out.append(e.path)
    return out


def old_files(root, days, suffix=""):
    """Các file trong cây thư mục root (đệ quy) cũ hơn `days` ngày."""
    cutoff = time.time() - days * DAY
    out = []
    for dirpath, _, files in os.walk(root):
        for f in files:
            if f.endswith(suffix):
                p = os.path.join(dirpath, f)
                try:
                    if os.lstat(p).st_mtime < cutoff:
                        out.append(p)
                except OSError:
                    pass
    return out


def paths_item(group, label, paths, detail, suggested=True, note=None):
    """Gộp nhiều đường dẫn rời rạc thành một mục (vd: các phiên cũ hơn 30 ngày)."""
    if not paths:
        return []
    return [Item(group, label, paths[0], kind="paths", detail=detail,
                 note=note or f"{len(paths)} mục", suggested=suggested, extra={"paths": paths})]


