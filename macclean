def stop_gradle():
    run(["pkill", "-f", "GradleDaemon"])
    run(["pkill", "-f", "KotlinCompileDaemon"])


def remove(p: Path, errs: list):
    if p.is_symlink() or not p.is_dir():
        try:
            p.unlink()
        except FileNotFoundError:
            pass
        except OSError as e:
            errs.append(e)
    else:
        shutil.rmtree(p, onerror=lambda _f, _p, exc: errs.append(exc[1]))


def delete_items(items, progress=None):
    """Xoá lần lượt; trả về (số thành công, số lỗi, dung lượng đã giải phóng)."""
    before = shutil.disk_usage(DATA_VOL).free
    gradle_stopped = False
    ok = fail = 0
    for n, it in enumerate(items, 1):
        if progress:
            progress(n, len(items), it)
        if it.extra.get("gradle") and not gradle_stopped:
            stop_gradle()
            gradle_stopped = True
        err = delete_item(it)
        it.selected = False
        if err:
            it.error = err
            fail += 1
        else:
            it.deleted = True
            ok += 1
    return ok, fail, max(0, shutil.disk_usage(DATA_VOL).free - before)


def delete_item(it: Item):
    """Trả về None nếu thành công, ngược lại là thông báo lỗi."""
    try:
        if it.kind == "sim":
            if it.extra.get("state") == "Booted":
                run(["xcrun", "simctl", "shutdown", it.target])
            r = run(["xcrun", "simctl", "delete", it.target], timeout=180)
            return None if r.returncode == 0 else (r.stderr.strip() or "simctl delete thất bại")
        if it.kind == "runtime":
            r = run(["xcrun", "simctl", "runtime", "delete", it.target], timeout=600)
            return None if r.returncode == 0 else (r.stderr.strip() or "simctl runtime delete thất bại")
        errs = []
        if it.kind == "paths":
            unsafe = [p for p in it.extra["paths"] if not is_safe(Path(p))]
            if unsafe:
                return f"đường dẫn không được phép xoá: {unsafe[0]}"
            for p in it.extra["paths"]:
                remove(Path(p), errs)
            return f"{len(errs)} file không xoá được ({errs[0]})" if errs else None
        p = Path(it.target)
        if not is_safe(p):
            return "đường dẫn nằm ngoài thư mục home, bỏ qua"
        if it.kind == "contents":
            for c in p.iterdir():
                remove(c, errs)
        else:
            remove(p, errs)
            if it.group == "archive":
                try:
                    p.parent.rmdir()  # xoá thư mục ngày nếu đã trống
                except OSError:
                    pass
        if errs:
            return f"{len(errs)} file không xoá được ({errs[0]})"
        return None
    except Exception as e:  # noqa: BLE001
        return str(e)


