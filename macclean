def fill_size(it: Item):
    if it.size is not None:
        return
    if it.kind != "paths":
        it.size = du_bytes(it.size_path or it.target)
        return
    total, paths = 0, it.extra["paths"]
    for i in range(0, len(paths), 200):
        r = run(["du", "-skc", *paths[i:i + 200]], timeout=900)
        try:
            total += int(r.stdout.strip().splitlines()[-1].split()[0]) * 1024
        except (IndexError, ValueError):
            pass
    it.size = total


def visible(it: Item):
    return it.size is None or it.size >= MIN_SHOW.get(it.group, 0)


