def run(cmd, timeout=60):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(cmd, 1, "", str(e))


def human(n):
    if n is None:
        return "…"
    for unit in ("B", "K", "M", "G", "T"):
        if abs(n) < 1024 or unit == "T":
            return f"{n:.0f}{unit}" if unit in "BK" else f"{n:.1f}{unit}"
        n /= 1024


def du_bytes(path):
    r = run(["du", "-sk", str(path)], timeout=900)
    try:
        return int(r.stdout.split()[0]) * 1024
    except (IndexError, ValueError):
        return 0


def ago(ts):
    if ts is None:
        return "chưa dùng"
    d = int((time.time() - ts) / DAY)
    return "hôm nay" if d <= 0 else f"{d} ngày trước"


def iso_ts(s):
    try:
        return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except (TypeError, ValueError):
        return None


def mtime(p):
    try:
        return p.stat().st_mtime
    except OSError:
        return None


def read_plist(p):
    try:
        with open(p, "rb") as f:
            return plistlib.load(f)
    except Exception:
        return {}


def dwidth(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in "WF" else 1


def fit(s, w, align="<"):
    """Cắt / đệm chuỗi theo độ rộng hiển thị trên terminal."""
    if w <= 0:
        return ""
    s = unicodedata.normalize("NFC", str(s))
    out, cur = [], 0
    for ch in s:
        cw = dwidth(ch)
        if cur + cw > w:
            while out and cur > w - 1:
                cur -= dwidth(out.pop())
            out.append("…")
            cur += 1
            break
        out.append(ch)
        cur += cw
    pad = " " * (w - cur)
    return pad + "".join(out) if align == ">" else "".join(out) + pad


def user_tmp():
    r = run(["getconf", "DARWIN_USER_TEMP_DIR"])
    return Path(r.stdout.strip() or os.environ.get("TMPDIR", "/tmp")).resolve()


SAFE_ROOTS = [HOME.resolve(), user_tmp(), Path("/private/tmp")]


def is_safe(p: Path):
    """Chỉ cho xoá đường dẫn nằm bên trong home, $TMPDIR hoặc /tmp (không phải chính các thư mục đó)."""
    try:
        rp = p.parent.resolve() / p.name
    except OSError:
        return False
    return any(rp != root and root in rp.parents for root in SAFE_ROOTS)


