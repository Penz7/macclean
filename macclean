@dataclass
class Item:
    group: str
    label: str
    target: str                 # đường dẫn, UDID simulator hoặc id runtime
    kind: str = "path"          # path | contents | sim | runtime | paths | info | launchd | brew | login | docker
    detail: str = ""
    note: str = ""
    size: int | None = None
    size_path: str = ""         # đường dẫn để tính dung lượng (nếu khác target)
    suggested: bool = False
    selected: bool = False
    deleted: bool = False
    error: str = ""
    extra: dict = field(default_factory=dict)


def scan_xcode():
    items = []
    base = HOME / "Library/Developer/Xcode"
    for d in sorted(base.glob("*DeviceSupport/*")):
        if d.is_dir():
            plat = d.parent.name.replace(" DeviceSupport", "")
            items.append(Item("xcode", f"DeviceSupport · {plat} {d.name}", str(d), detail=str(d),
                              note=ago(mtime(d)), suggested=True))
    dd = base / "DerivedData"
    if dd.is_dir():
        for d in sorted(dd.iterdir()):
            if d.is_dir():
                name = re.sub(r"-[a-z]{20,}$", "", d.name)
                items.append(Item("xcode", f"DerivedData · {name}", str(d), detail=str(d),
                                  note=ago(mtime(d)), suggested=True))
    return items


def scan_archives():
    items = []
    base = HOME / "Library/Developer/Xcode/Archives"
    if not base.is_dir():
        return items
    for arc in base.glob("*/*.xcarchive"):
        info = read_plist(arc / "Info.plist")
        app = info.get("ApplicationProperties", {})
        name = info.get("Name") or arc.stem
        ver = app.get("CFBundleShortVersionString", "")
        build = app.get("CFBundleVersion", "")
        created = info.get("CreationDate")
        ts = created.replace(tzinfo=timezone.utc).timestamp() if isinstance(created, datetime) else mtime(arc)
        when = datetime.fromtimestamp(ts).strftime("%d/%m/%Y %H:%M") if ts else "?"
        vb = f" {ver} ({build})" if ver else ""
        items.append(Item("archive", f"{when} · {name}{vb}", str(arc), detail=str(arc),
                          note=ago(ts), extra={"ts": ts or 0, "app": name}))
    items.sort(key=lambda i: i.extra["ts"], reverse=True)
    newest = {}
    for it in items:
        newest.setdefault(it.extra["app"], it)
    for it in items:
        it.suggested = it is not newest[it.extra["app"]] and time.time() - it.extra["ts"] > 60 * DAY
    return items


def runtime_name(rid):
    # com.apple.CoreSimulator.SimRuntime.iOS-26-5 → iOS 26.5
    tail = rid.rsplit(".", 1)[-1]
    plat, _, ver = tail.partition("-")
    return f"{plat} {ver.replace('-', '.')}".strip()


def scan_simulators():
    if not shutil.which("xcrun"):
        return [], []
    r = run(["xcrun", "simctl", "list", "devices", "-j"])
    try:
        devices = json.loads(r.stdout)["devices"]
    except (ValueError, KeyError):
        devices = {}
    sims, count = [], {}
    for rid, devs in devices.items():
        count[rid] = len(devs)
        for dv in devs:
            udid = dv["udid"]
            ddir = Path(dv["dataPath"]).parent if dv.get("dataPath") else \
                HOME / "Library/Developer/CoreSimulator/Devices" / udid
            last = iso_ts(dv.get("lastBootedAt"))
            avail = dv.get("isAvailable", True)
            note = ago(last) if avail else "không khả dụng"
            stale = last is not None and time.time() - last > 90 * DAY
            sims.append(Item("sim", f"{runtime_name(rid)} · {dv['name']}", udid, kind="sim",
                             detail=f"{udid} · {dv.get('state', '')} · {ddir}", note=note,
                             size_path=str(ddir), suggested=(not avail) or stale,
                             extra={"state": dv.get("state")}))
    sims.sort(key=lambda i: i.label)

    runtimes = []
    r = run(["xcrun", "simctl", "runtime", "list", "-j"])
    try:
        rts = json.loads(r.stdout)
    except ValueError:
        rts = {}
    for rid, rt in rts.items():
        if not rt.get("deletable", True):
            continue
        ident = rt.get("runtimeIdentifier", "")
        n = count.get(ident, 0)
        last = iso_ts(rt.get("lastUsedAt"))
        stale = last is not None and time.time() - last > 90 * DAY
        label = f"{runtime_name(ident) if ident else rid} ({rt.get('build', '?')})"
        runtimes.append(Item("runtime", label, rid, kind="runtime", size=rt.get("sizeBytes", 0),
                             detail=f"{n} simulator · lần dùng cuối: {ago(last)} · {rt.get('path', '')}",
                             note=f"{n} sim · {ago(last)}", suggested=n == 0 or stale))
    return sims, runtimes


def gradle_version(name):
    m = re.search(r"gradle-(\d+(?:\.\d+)*)-", name)
    return tuple(int(x) for x in m.group(1).split(".")) if m else None


